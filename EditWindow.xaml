<Window x:Class="market.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:market"
        mc:Ignorable="d"
        Title="EditWindow" Height="450" Width="800" FontFamily="Arial Black" FontSize="20">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" >
            <TextBox Height="50" Width="400" Margin="20 20 0 0"/>
            <TextBlock Text="Название" Margin="20 20 0 0" VerticalAlignment="Center"/>
            <TextBox Height="50" Width="400" Margin="20 20 0 0"/>
            <TextBlock Text="Цена" Margin="20 20 0 0" VerticalAlignment="Center"/>
            <TextBox Height="50" Width="400" Margin="20 20 0 0"/>
            <TextBlock Text="Количество" Margin="20 20 0 0" VerticalAlignment="Center"/>
            <TextBox Height="150" Width="400" Margin="20 20 0 0" />
            <TextBlock Text="Описание" Margin="20 20 0 0" VerticalAlignment="Center"/>
            <Button Content="Изменить" Margin="350 20 0 0" Click="changeButton"/>
        </WrapPanel>
        
    </DockPanel>
</Window>