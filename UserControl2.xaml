<UserControl x:Class="market.UserControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:market"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ListBox x:Name="ProductListBox">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <WrapPanel Margin="10">
                    <Border BorderBrush="Black" BorderThickness="2" Width="760" Height="250" Padding="5" Background="White" Margin="5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Width="250" VerticalAlignment="Stretch">
                                <Border BorderBrush="Gray" BorderThickness="1" Height="190" Margin="5">
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0} Р'}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Grid Margin="15 5 5 5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontFamily="Arial" FontSize="32" Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="1" Text="{Binding Description, StringFormat='Описание: {0}'}" VerticalAlignment="Top"  Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding Count, StringFormat='количество: {0}'}"  VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </WrapPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
