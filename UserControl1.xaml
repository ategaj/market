<UserControl x:Class="market.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:market"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" FontFamily="Arial Black" FontSize="20">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <TextBox x:Name="NameTxt" Height="50" Width="400" Margin="20 20 0 0"/>
            <TextBlock Text="Название" Margin="20 20 0 0" VerticalAlignment="Center"/>

            <TextBox x:Name="PriceTxt" Height="50" Width="400" Margin="20 20 0 0"/>
            <TextBlock Text="Цена" Margin="20 20 0 0" VerticalAlignment="Center"/>

            <TextBox x:Name="CountTxt" Height="50" Width="400" Margin="20 20 0 0"/>
            <TextBlock Text="Количество" Margin="20 20 0 0" VerticalAlignment="Center"/>

            <TextBox x:Name="DescTxt" Height="150" Width="400" Margin="20 20 0 0" TextWrapping="Wrap"/>
            <TextBlock Text="Описание" Margin="20 20 0 0" VerticalAlignment="Center"/>

            <Image x:Name="ProductImage" Width="150" Height="150" Margin="20 20 0 0" Stretch="Uniform"/>

            <StackPanel Orientation="Vertical" Margin="20 20 0 0" VerticalAlignment="Bottom">
                <Button Content="Выбрать фото" Height="30" Width="230" Margin="0 0 0 10" Click="UploadImage_Click"/>
                <Button x:Name="edit" Content="Изменить" Height="30" Width="230" Click="changeButton"/>
            </StackPanel>
        </WrapPanel>
    </DockPanel>
</UserControl>
